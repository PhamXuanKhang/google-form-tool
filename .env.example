# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=0

# Database
DB_PATH=app/services/db.json

# Chrome paths (optional — leave blank to use system Chrome + auto-download ChromeDriver)
# Uncomment and set only if you want to override auto-detection:
# CHROME_BINARY_PATH=C:\Path\To\chrome.exe
# CHROME_DRIVER_PATH=C:\Path\To\chromedriver.exe

# Google Gemini AI (optional - not yet integrated)
GEMINI_API_KEY=your-gemini-api-key
# Optional Gemini model name (example: models/gemini-1.5-flash)
GEMINI_MODEL=

# Debug-only: include a redacted prefill URL sample in /start_submission response (0/1)
PREFILL_DEBUG_SAMPLE=0

# Test Google Form URL for integration/beta testing (optional)
# When set, integration tests and beta runbook use this URL.
# Leave empty to fall back to the bundled sample form URL.
TEST_GOOGLE_FORM_URL=
