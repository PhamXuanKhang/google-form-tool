msgstr "Không thể trích xuất biểu mẫu. Vui lòng kiểm tra URL và thử lại."

msgid "Page"
msgstr "Trang"

msgid "Type"
msgstr "Loại"

msgid "No questions on this page."
msgstr "Trang này không có câu hỏi."

msgid "No page/question structure found."
msgstr "Không tìm thấy cấu trúc trang hoặc câu hỏi."

msgid "Please enter an API key"
msgstr "Vui lòng nhập khóa API"

msgid "Validating..."
msgstr "Đang kiểm tra..."

msgid "API key is valid!"
msgstr "Khóa API hợp lệ!"

msgid "Invalid API key"
msgstr "Khóa API không hợp lệ"

msgid "Please extract a form first."
msgstr "Vui lòng trích xuất biểu mẫu trước."

msgid "Please enter and validate your API key first."
msgstr "Vui lòng nhập và kiểm tra khóa API trước."

msgid "Generating..."
msgstr "Đang tạo..."

msgid "AI responses generated!"
msgstr "Đã tạo câu trả lời bằng AI!"

msgid "Generated Responses Preview:"
msgstr "Xem trước câu trả lời đã tạo:"

msgid "Failed to generate responses"
msgstr "Không thể tạo câu trả lời"

msgid "Please extract a form first before uploading data."
msgstr "Vui lòng trích xuất biểu mẫu trước khi tải dữ liệu lên."

msgid "Please select a file to upload."
msgstr "Vui lòng chọn tệp để tải lên."

msgid "File loaded successfully!"
msgstr "Đã tải tệp thành công!"

msgid "response sets ready for submission."
msgstr "bộ câu trả lời sẵn sàng để gửi."

msgid "Preview (first 3 rows):"
msgstr "Xem trước (3 dòng đầu):"

msgid "Failed to load file"
msgstr "Không thể tải tệp"

msgid "Error uploading file:"
msgstr "Lỗi khi tải tệp lên:"

msgid "Please enter a Google Form URL."
msgstr "Vui lòng nhập URL Google Form."

msgid "Please extract the form before continuing."
msgstr "Vui lòng trích xuất biểu mẫu trước khi tiếp tục."

msgid "Please upload a file with answer data."
msgstr "Vui lòng tải lên tệp chứa dữ liệu trả lời."

msgid "Submission started successfully"
msgstr "Đã bắt đầu gửi biểu mẫu"

msgid "Failed to start submission. Check console for details."
msgstr "Không thể bắt đầu gửi. Xem console để biết chi tiết."

msgid "Submission stopped"
msgstr "Đã dừng gửi"

msgid "Failed to stop submission. Check console for details."
msgstr "Không thể dừng gửi. Xem console để biết chi tiết."

msgid "No active submission for this form."
msgstr "Không có phiên gửi nào đang chạy cho biểu mẫu này."

msgid "Number of submissions must be between 1 and 500."
msgstr "Số lần gửi phải nằm trong khoảng 1 đến 500."

msgid "Concurrent threads must be between 1 and 10."
msgstr "Số luồng đồng thời phải nằm trong khoảng 1 đến 10."

msgid "Concurrent threads cannot be greater than submissions."
msgstr "Số luồng đồng thời không được lớn hơn số lần gửi."

msgid "Delays must be non-negative numbers."
msgstr "Độ trễ phải là số không âm."

msgid "Maximum delay must be greater than or equal to minimum delay."
msgstr "Độ trễ tối đa phải lớn hơn hoặc bằng độ trễ tối thiểu."

msgid "Failed to save manual configuration."
msgstr "Không thể lưu cấu hình thủ công."

msgid "No manual configuration to save."
msgstr "Không có cấu hình thủ công để lưu."

