msgstr "Bước 3: Cài đặt tự động hóa"

msgid "Number of submissions"
msgstr "Số lần gửi"

msgid "Maximum 500 submissions per batch."
msgstr "Tối đa 500 lần gửi mỗi lượt."

msgid "Concurrent threads"
msgstr "Số luồng đồng thời"

msgid "Maximum 10 threads. Threads should not exceed submissions."
msgstr "Tối đa 10 luồng. Số luồng không nên lớn hơn số lần gửi."

msgid "Minimum delay seconds"
msgstr "Độ trễ tối thiểu (giây)"

msgid "Maximum delay seconds"
msgstr "Độ trễ tối đa (giây)"

msgid "Backend limits still apply: max 500 submissions, max 10 threads, and threads cannot exceed submissions."
msgstr "Giới hạn backend vẫn được áp dụng: tối đa 500 lần gửi, tối đa 10 luồng, và số luồng không được lớn hơn số lần gửi."

msgid "Review and Start"
msgstr "Kiểm tra và bắt đầu"

